# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=db_name

# Connection string used by the app.
# Host is the db service name on the docker network.
DATABASE_URL=postgres://postgres:changeme@ink-boat_db:5432/db_name
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app
BETTER_AUTH_SECRET=
## AI providers
# Users bring their own provider key (BYOK), so the app holds no provider key of its own.
# This secret seals the user keys at rest (AES-256-GCM). It must hold 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Lose it and every stored key becomes unreadable, so users must enter theirs again.
PROVIDER_SECRET_KEY=
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/lib/db/generated/"
}

datasource db {
  provider = "postgresql"
}

// schema.prisma
// Medium-style blogging app — initial schema
// Pattern: BigInt internal PK (fast joins) + nanoid public_id (clean, unguessable URLs)

// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  drafts        Draft[]
  providerKeys  ProviderKey[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?

  @@map("jwks")
}

enum DraftStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AIProvider {
  GEMINI
  ANTHROPIC
}

// A user's own key for one AI provider (BYOK). The key is sealed with AES-256-GCM
// before it reaches this table — see src/lib/crypto/providerKeys.ts.
model ProviderKey {
  id       BigInt @id @default(autoincrement())
  publicId String @unique @default(nanoid(12)) @map("public_id") @db.VarChar(12) // named by the client on delete

  provider   AIProvider
  label      String // user-facing name, so two keys are told apart
  ciphertext Bytes // iv (12 B) || authTag (16 B) || sealed key
  keyVersion Int       @default(1) @map("key_version") // which master secret sealed this row
  last4      String    @map("last_4") @db.VarChar(4) // renders the masked key with no decrypt
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("provider_keys")
}

model Draft {
  id       BigInt @id @default(autoincrement()) // internal: joins / FKs only
  publicId String @unique @default(nanoid(12)) @map("public_id") @db.VarChar(12) // goes in the URL

  title       String      @default("")
  description String      @default("")
  slug        String? // slugify(title); cosmetic only, NOT unique (URL = slug + "-" + publicId)
  content     Json? // Tiptap / ProseMirror document (output of editor.getJSON())
  wordCount   Int         @default(0) @map("word_count") // reading time is derived from this, never stored
  status      DraftStatus @default(DRAFT)
  config      Json        @default("{}") // free-form, never-queried settings: theme, editor prefs, layout
  publishedAt DateTime?   @map("published_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  media Media[]
  notes Note[]

  // "my drafts", filterable by status
  // public feed of published posts, newest first
  @@index([userId, status])
  @@index([status, publishedAt])
  @@map("drafts")
}

// ---------------------------------------------------------------------------

// Margin notes written alongside a draft in the editor's side panel.
model Note {
  id       BigInt @id @default(autoincrement())
  publicId String @unique @default(nanoid(12)) @map("public_id") @db.VarChar(12) // named by the client on edit / delete

  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  draftId BigInt @map("draft_id")
  draft   Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
  @@map("notes")
}

// ---------------------------------------------------------------------------

model Media {
  id         BigInt   @id @default(autoincrement())
  storageKey String   @map("storage_key") // R2 object key — NOT the image bytes
  mimeType   String?  @map("mime_type")
  altText    String?  @map("alt_text")
  position   Int? // ordering within the draft
  width      Int?
  height     Int?
  sizeBytes  BigInt?  @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  draftId BigInt @map("draft_id")
  draft   Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, position])
  @@map("media")
}
